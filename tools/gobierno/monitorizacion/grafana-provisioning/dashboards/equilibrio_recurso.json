{
  "title": "Equilibrio del recurso — GASTO_API real",
  "uid": "engremiat-equilibrio-recurso",
  "timezone": "browser",
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Gasto real — últimas 24h",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "engremiat_gasto_api_coste_usd_24h", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } }
    },
    {
      "id": 2,
      "title": "Gasto real — últimos 7 días",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "engremiat_gasto_api_coste_usd_7d", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } }
    },
    {
      "id": 3,
      "title": "Llamadas reales — últimas 24h",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "engremiat_gasto_api_llamadas_24h", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Proyección mensual vs. tope real ($5)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "engremiat_gasto_api_coste_usd_24h * 30", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "max": 5,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3.5 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Gasto acumulado total, por modelo",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "engremiat_gasto_api_coste_por_modelo_usd", "legendFormat": "{{modelo}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 6,
      "title": "Gasto en las últimas 24h, en el tiempo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "engremiat_gasto_api_coste_usd_24h", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    }
  ]
}
